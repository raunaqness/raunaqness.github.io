# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=photos-raunaqness
R2_ENDPOINT=https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_PUBLIC_BASE_URL=https://photos.raunaqness.com

# Cloudflare cache purge (zone-level token, NOT the R2 bucket token)
# Create at: My Profile -> API Tokens -> Create Token -> permissions: Zone / Cache Purge / Purge
# Scope it to the raunaqness.com zone only.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Google Drive (service account)
# path to the service account JSON key downloaded from Google Cloud Console
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./service-account.json
# Drive folder ID containing the album subfolders (from the folder's URL),
# must be shared with the service account's email as Viewer
GOOGLE_DRIVE_ROOT_FOLDER_ID=
